{
  "name": "passenger-rights-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lighthouse:home": "npx --yes lighthouse http://localhost:3001/en --only-categories=performance,accessibility,best-practices,seo --output=json --output=html --output-path=./doc/lighthouse-baseline --chrome-flags=\"--headless --no-sandbox\" --quiet"
  },
  "dependencies": {
    "next": "15.5.20",
    "next-intl": "^4.13.4",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.20",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "typescript": "^5"
  }
}
